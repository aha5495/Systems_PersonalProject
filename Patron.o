import java.util.ArrayList;
//Programmer:Aravind Alwar
//Date:August 10,2024
//File:Person.java
//Description: The class for the customer to enter their information,calculates the best Theaters;
public abstract class Person implements Browser{
    private String cus_fName;
    private String cus_mName;
    private String cus_lName;
    private float cus_Age;
    private String movie_Genre; //What genre(s) of movie the customer(s) are looking for;
    private float radius; //How far away from home the customer wants to travel;
    private ArrayList<Movie> allMovies; //All possible Movies the person can choose;
    private String crit;
    private Movie chosenMovie; //Edit 3/11:We need a Movie object so that the user knows what movie they want to select for displaying the search;
    private ArrayList<Theater> possibleAreas; //Create an arrayList to account for all the movie theaters in their area
    private Theater dest; //The movie Theater the customer chooses given the radius;
    private Home residence;
    public Person(){ //Constructor with no parameters
        cus_fName = " ";
        cus_mName = " ";
        cus_lName = " ";
        cus_Age = 0f;
        movie_Genre = " ";
        radius = 0f;
        residence = null;
    }
    public Person(String cus_fName,String cus_mName,String cus_lName){ //Constructor used for film crew/cast
        this.cus_fName = cus_fName;
        this.cus_mName = cus_mName;
        this.cus_lName = cus_lName;
    }
    //Constructor with Parameters to effectively instantiate;
    public Person(String cus_fName,String cus_mName,String cus_lName,float cus_Age,Home residence){
        this.cus_fName = cus_fName;
        this.cus_mName = cus_mName;
        this.cus_lName = cus_lName;
        this.cus_Age = cus_Age;
        this.residence = residence;
        //Error Checking Input--for the user's age;
        if(this.cus_Age<0){
            throw new IllegalArgumentException("Invalid age,please try again with a value greater than 0!");
        }
        //Age constraint condition:R rated movies;
        if(this.cus_Age<17){
            System.out.println("You need to show proof of your age to see R-rated alone.Otherwise,you are only allowed in with a parent.");
        }
    }
    //Constructor 2,COMPLETELY Parameterized;
    public Person(String cus_fName,String cus_mName,String cus_lName,float cus_Age,String movie_Genre,float radius,Movie chosenMovie,Home residence){
        this.cus_fName = cus_fName;
        this.cus_mName = cus_mName;
        this.cus_lName = cus_lName;
        this.cus_Age = cus_Age;
        this.movie_Genre = movie_Genre;
        this.radius = radius;
        this.residence = residence;
        this.chosenMovie = chosenMovie;
        if(this.cus_Age<0){
            throw new IllegalArgumentException("Age is not positive");
        }
        //Age constraint condition:R rated movies;
        if(this.cus_Age<17){
            System.out.println("You need to show proof of your age to see R-rated alone.Otherwise,you are only allowed in with a parent.");
        }
    }
    //Additional Constructor: Without the genre parameter,if a customer chooses any movie;
    public Person(String cus_fName,String cus_mName,String cus_lName,float cus_Age,float radius,Movie chosenMovie,Home residence){
        this.cus_fName = cus_fName;
        this.cus_mName = cus_mName;
        this.cus_lName = cus_lName;
        this.cus_Age = cus_Age;
        this.radius = radius;
        this.residence = residence;
        this.chosenMovie = chosenMovie;
        if(this.cus_Age<0){
            throw new IllegalArgumentException("Age is not positive");
        }
        //Age constraint condition:R rated movies;
        if(this.cus_Age<17){
            System.out.println("You need to show proof of your age to see R-rated alone.Otherwise,you are only allowed in with a parent.");
        }
    }
    //Setters and Getters
    public void setCus_firstName(String cus_fName){
        this.cus_fName = cus_fName;
    }
    public void setCus_mName(String cus_mName){
        this.cus_mName = cus_mName;
    }
    public void setCus_lName(String cus_lName){
        this.cus_lName = cus_lName;
    }
    public void setCus_Age(float cus_Age){
        this.cus_Age = cus_Age;
    }
    public void setMovie_Genre(String movie_Genre){
        this.movie_Genre = movie_Genre;
    }
    public void setDistance(float radius){
        this.radius = radius;
    }
    public void setResidence(Home residence){
        this.residence = residence;
    }
    public void setMovie(Movie chosenMovie){
        this.chosenMovie = chosenMovie;
    }
    public Movie getChosenMovie(){
        return this.chosenMovie;
    }
    public void setTheaters(ArrayList<Theater> possibleAreas){
        this.possibleAreas = possibleAreas;
    }
    public ArrayList<Theater> getTheaters(){
        return this.possibleAreas;
    }
    public void setCinema(Theater dest){
        this.dest = dest;
    }
    public Theater getCinema(){
        return this.dest;
    }
    public String getCus_fName(){
        return this.cus_fName;
    }
    public String getCus_mName(){
        return this.cus_mName;
    }
    public String getCus_lName(){
        return this.cus_lName;
    }
    public float getCus_Age(){
        return this.cus_Age;
    }
    public String getMovie_Genre(){
        return this.movie_Genre;
    }
    public float getDistance(){
        return this.radius;
    }
    public Home getResidence(){
        return this.residence;
    }
    @Override
    public boolean search(String film_Name) { //Need to implement it in a way that tells the results matching for films;
        boolean film_Found=false;
        System.out.println("Searching the browser for:"+film_Name);
        if(allMovies.isEmpty()){
            film_Found=false; //The film is not in the arrayList;
        }
        else{
            //Check conditions for if the film_Name entered by the user IS IN the arrayList
            for(Movie r:allMovies){
                if(r.getFilmTitle().equalsIgnoreCase(film_Name)){ //Checking if the query equals r.getFilmTitle()
                    film_Found=true;
                }
                else{ //If not found,the search doesn't contain keywords for the title;
                    film_Found=false;
                }
            }
        }
        return film_Found;
    }
    @Override
    public void display_search(String film_Name,String crit){ //Update:Need another variable
        if(!search(film_Name)){
            System.out.println("The movie cannot be found either because the Movie List is empty or it simply hasnt been released.");
        }
        else{ //Challenge:Make any of the constructors show
            switch(crit){
                case "Stars":
                    chosenMovie=new Movie(chosenMovie.getFilmTitle(),chosenMovie.getDirector(),chosenMovie.getActorsNames());
                case "Year":
                    chosenMovie=new Movie(chosenMovie.getFilmTitle(), chosenMovie.getFilmMonth(),chosenMovie.getFilmMonth(),chosenMovie.getFilmYear(), chosenMovie.getDirector());
                case "General":
                    chosenMovie=new Movie(chosenMovie.getFilmTitle(),chosenMovie.getFilmMonth(),chosenMovie.getFilmDay(),chosenMovie.getFilmYear(), chosenMovie.getBoxPrice(), chosenMovie.getFilm_Genre(),chosenMovie.getDirector(),chosenMovie.getActorsNames(), getChosenMovie().getRating(), chosenMovie.getMins());
                case "Rating":
                    chosenMovie=new Movie(chosenMovie.getFilmTitle(),chosenMovie.getDirector(),chosenMovie.getActorsNames(), chosenMovie.getRating());
                default:
                    System.out.println("Invalid criteria.You can choose either with Stars,Year,Rating,or general movie info");
            }
            System.out.println("Here is the information for "+chosenMovie.getFilmTitle());
            System.out.println(chosenMovie.toString());
        }
    }
    //Displaying the Patron's information;
    public void profile(){
        System.out.println("Movie Theater:"+this.getCinema()+"\nName:"+this.getCus_fName()+" "+this.getCus_mName()+".   "+this.getCus_lName());
    }
}

